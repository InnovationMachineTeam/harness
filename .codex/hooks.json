{
  "description": "Agent OS policy guard: pipes {tool_name, tool_input} to .agents/runtime/guard.mjs before tool calls; exit 2 blocks the call with the reason on stderr.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_RUNTIME=codex AGENT_RUNTIME_CONFIG=.agents/runtime/codex/config.json node .agents/runtime/guard.mjs",
            "timeout": 30,
            "statusMessage": "Checking against repository policy"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-check"
          }
        ]
      }
    ]
  }
}