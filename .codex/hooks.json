{
  "description": "Harness Guardrails: проверка вызовов до исполнения; exit 2 блокирует вызов.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_RUNTIME=codex AGENT_RUNTIME_CONFIG=.agents/runtime/codex/config.json GUARDRAILS_INTEGRATION=runtime:codex:PreToolUse bun .guardrails/src/cli.ts evaluate",
            "timeout": 30,
            "statusMessage": "Checking against repository policy"
          }
        ]
      }
    ]
  }
}
