{
  "mcpServers": {
    "webmcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@jason.today/webmcp@latest",
        "--mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "qmd": {
      "type": "stdio",
      "command": "qmd",
      "args": [
        "mcp"
      ]
    },
    "openwiki": {
      "command": "openwiki",
      "args": [
        "mcp",
        "--host",
        "claude"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "open-design": {
      "type": "stdio",
      "command": "od",
      "args": [
        "mcp",
        "--daemon-url",
        "http://127.0.0.1:7456"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/"
    },
    "excalidraw": {
      "type": "http",
      "url": "https://mcp.excalidraw.com"
    },
    "google-design": {
      "type": "http",
      "url": "https://design.googleapis.com/mcp"
    },
    "stitch": {
      "type": "stdio",
      "command": "stitch",
      "args": [
        "mcp",
        "start"
      ]
    }
  }
}
