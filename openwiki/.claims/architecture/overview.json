    {
      "id": "claim_74abaa56cdcb46a8a013445bb3ac5233",
      "statement": "The console is layered as pages/components/zustand store, fetch (RSC payload / JSON / SSE), API routes (src/app/api), src/core modules, src/runtimes adapters, and machine touchpoints; API routes build a ServerContext (repoRoot + loaded state + ADAPTERS + saveState) via src/lib/server-context.ts, and adapters receive a ProbeContext so they never access the filesystem directly.",
      "evidence": [
        {
          "resource": "repo://apps/console/src/core/types.ts",
