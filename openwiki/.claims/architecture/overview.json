    {
      "id": "claim_ccbc9db960af4442bfdd39db0651f35e",
      "statement": "The Harness Console is a Next.js 16 App Router application (package @harness/console) inside the repository's Bun workspace (apps/*), started from the repo root via bun run console; its runtime dependencies are next, react, react-dom, zustand, react-markdown, remark-gfm, lucide-react, yaml and @google/design.md, and server code reaches the machine only through node:* builtins.",
      "evidence": [
        {
          "resource": "repo://apps/console/package.json",
          "version": "repo-file-v1:sha256:460dafec7c103c8cf99b93d005efe67417c19df3c2784739347f22f37e42b427"
        },
        {
