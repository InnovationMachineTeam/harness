{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_RUNTIME=claude AGENT_RUNTIME_CONFIG=\"${CLAUDE_PROJECT_DIR}/.agents/runtime/claude/config.json\" node \"${CLAUDE_PROJECT_DIR}/.agents/runtime/guard.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read --strict",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  }
}
