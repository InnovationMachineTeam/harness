{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/"
    },
    "webmcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@jason.today/webmcp@latest",
        "--mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "qmd": {
      "type": "stdio",
      "command": "qmd",
      "args": [
        "mcp"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "open-design": {
      "type": "stdio",
      "command": "od",
      "args": [
        "mcp",
        "--daemon-url",
        "http://127.0.0.1:7456"
      ]
    },
    "excalidraw": {
      "type": "http",
      "url": "https://mcp.excalidraw.com"
    },
    "google-design": {
      "type": "http",
      "url": "https://design.googleapis.com/mcp"
    },
    "stitch": {
      "type": "stdio",
      "command": "stitch",
      "args": [
        "mcp",
        "start"
      ]
    },
    "neo4j": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-neo4j-memory",
        "--transport",
        "stdio"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "harness-memory"
      }
    },
    "qdrant": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://127.0.0.1:6333",
        "COLLECTION_NAME": "harness-memory"
      }
    }
  }
}
